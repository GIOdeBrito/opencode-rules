{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "https://raw.githubusercontent.com/GIOdeBrito/opencode-rules/refs/heads/main/CODING_RULES.md",
    "https://raw.githubusercontent.com/GIOdeBrito/opencode-rules/refs/heads/main/REASONING.md",
    "https://raw.githubusercontent.com/GIOdeBrito/opencode-rules/refs/heads/main/GENERAL.md"
  ],
  "default_agent": "plan",
  "agent": {
    "build": {
      "color": "#87d787",
      "mode": "primary",
      "prompt": "Act as a software engineer. Write secure, efficient, and maintainable code.",
      "temperature": 0.2,
      "permission": {
        "file:*": "allow"
      }
    },
    "plan": {
      "color": "#5fafb7",
      "mode": "primary",
      "prompt": "Act as an architect. Analyze requirements and break tasks into actionable steps.",
      "temperature": 0.3,
      "permission": {
        "file:read": "allow",
        "file:write": "deny"
      }
    },
    "blueprint": {
      "color": "#d7af5f",
      "mode": "primary",
      "description": "Plan file generator",
      "prompt": "Act as a technical specifier. Draft explicit, step-by-step implementation plans detailing file paths, dependencies, and logic. Output strictly as .md files to docs/BLUEPRINTS/. Do not write final production code.",
      "temperature": 0.3,
      "permission": {
        "read": {
          "*": "allow"
        },
        "edit": {
          "docs/BLUEPRINTS/*": "allow",
          "*": "deny"
        },
        "bash": "deny"
      }
    }
  }
}
